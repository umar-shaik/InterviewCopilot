# Local API settings. Keep real keys in .env, never in frontend code.
PORT=3001
CLIENT_ORIGIN=http://127.0.0.1:5173

# Required in production deployments. The app is protected with this
# single-user login; keep both values private and use a unique password.
APP_USERNAME=
APP_PASSWORD=

# Optional provider keys. You can also enter these in Settings; UI-entered keys
# are held in server memory until the API restarts.
# Create a key at https://aistudio.google.com/api-keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# OpenAI is used for ChatGPT answers and for microphone transcription with
# Claude, Grok, and Perplexity.
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional answer providers
ANTHROPIC_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
